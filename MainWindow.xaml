<Window x:Class="JobMore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JobMore.ViewModels"
        Title="잡모아 JobMore" Height="820" Width="1280"
        Icon="/Assets/logo.png"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel LastChildFill="True">

        <!-- ════ 사이드바 (다크) ════ -->
        <Border DockPanel.Dock="Left" Width="244" Background="{StaticResource SideBg}"
                Visibility="{Binding ShowChrome, Converter={StaticResource BoolVis}}">
            <Grid Margin="20,26,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 로고 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,28" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="44" Height="44" Stretch="Uniform" Margin="0,0,11,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="잡모아" FontSize="22" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="JobMore" FontSize="11" Foreground="{StaticResource SideText}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 네비게이션 -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Key}" Cursor="Hand" Margin="0,0,0,6">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="11" Padding="13,11" Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16" VerticalAlignment="Center"
                                                           Foreground="{StaticResource SideText}" x:Name="ic" />
                                                <TextBlock Text="{Binding Label}" Margin="14,0,0,0"
                                                           VerticalAlignment="Center" FontSize="14" FontWeight="Medium"
                                                           Foreground="{StaticResource SideText}" x:Name="tx" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#9B82FC" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="b"  Property="Background" Value="White" />
                                                <Setter TargetName="ic" Property="Foreground" Value="{StaticResource SignatureDeep}" />
                                                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource SignatureDeep}" />
                                                <Setter TargetName="tx" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 하단 -->
                <TextBlock Grid.Row="2" Text="ⓘ 흩어진 지원 현황을 모아서, 합격은 더"
                           Foreground="{StaticResource SideText}" FontSize="11" TextWrapping="Wrap"
                           Opacity="0.7" />
            </Grid>
        </Border>

        <!-- ════ 콘텐츠 영역 ════ -->
        <ContentControl Content="{Binding CurrentViewModel}" />

    </DockPanel>
</Window>
