<Application x:Class="JobMore.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:JobMore.Converters"
             xmlns:vm="clr-namespace:JobMore.ViewModels"
             xmlns:views="clr-namespace:JobMore.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ════ 컨버터 ════ -->
            <conv:EnumToDescriptionConverter x:Key="EnumDesc" />
            <conv:StageToBrushConverter      x:Key="StageBrush" />
            <conv:DdayToTextConverter        x:Key="DdayText" />
            <conv:DdayToBrushConverter       x:Key="DdayBrush" />
            <BooleanToVisibilityConverter    x:Key="BoolVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolVis" />
            <conv:FirstCharConverter         x:Key="FirstChar" />
            <conv:HexToBrushConverter        x:Key="HexBrush" />
            <conv:ColorMatchToVisibilityConverter x:Key="ColorMatch" />
            <conv:DoubleToStarConverter      x:Key="StarLen" />

            <!-- ════ ViewModel → View 매핑 ════ -->
            <DataTemplate DataType="{x:Type vm:ApplicationsViewModel}">
                <views:ApplicationsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecordViewModel}">
                <views:RecordView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
                <views:CalendarView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WritingViewModel}">
                <views:WritingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SignUpViewModel}">
                <views:SignUpView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>

            <!-- ════ 디자인 토큰 — 스카이 블루 ════ -->
            <SolidColorBrush x:Key="Signature"     Color="#7C5CFC" />
            <SolidColorBrush x:Key="SignatureDeep" Color="#6A45F0" />
            <SolidColorBrush x:Key="SignatureSoft" Color="#F0ECFE" />
            <LinearGradientBrush x:Key="SignatureGrad" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#8366FC" Offset="0" />
                <GradientStop Color="#6E4EF5" Offset="1" />
            </LinearGradientBrush>

            <!-- 사이드바 (스카이 블루) -->
            <SolidColorBrush x:Key="SideBg"     Color="#7C5CFC" />
            <SolidColorBrush x:Key="SideText"   Color="#E6DEFD" />
            <SolidColorBrush x:Key="SideActive" Color="#FFFFFF" />

            <!-- 본문(라이트) -->
            <SolidColorBrush x:Key="Bg"    Color="#F4F6FB" />
            <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Ink"   Color="#16223A" />
            <SolidColorBrush x:Key="Sub"   Color="#6B7A90" />
            <SolidColorBrush x:Key="Line"  Color="#E7ECF3" />

            <!-- 상태색 -->
            <SolidColorBrush x:Key="Mint"  Color="#1F9D57" />
            <SolidColorBrush x:Key="Coral" Color="#E0524F" />
            <SolidColorBrush x:Key="Amber" Color="#E08A2B" />

            <!-- 공통 폰트 (나눔/본고딕 우선, 없으면 맑은 고딕) -->
            <FontFamily x:Key="UiFont">NanumGothic, Noto Sans KR, Noto Sans CJK KR, Malgun Gothic, Segoe UI</FontFamily>

            <!-- ════ 카드 ════ -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBg}" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#2A3C66" BlurRadius="26" ShadowDepth="2"
                                          Direction="270" Opacity="0.08" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ════ Primary 버튼 (둥근 + 호버 살짝 커짐) ════ -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="13" Padding="{TemplateBinding Padding}"
                                    Background="{StaticResource SignatureGrad}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="s" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="s" Storyboard.TargetProperty="ScaleX"
                                                                 To="1.03" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="s" Storyboard.TargetProperty="ScaleY"
                                                                 To="1.03" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="s" Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="s" Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Copy (파란 보조 액션) -->
            <Style x:Key="CopyButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="13" Background="#2C9BD6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#2589BE" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ghost -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource SignatureDeep}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="13" Background="{StaticResource SignatureSoft}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#E2D9FC" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Subtle (작은 보조) -->
            <Style x:Key="SubtleButton" TargetType="Button">
                <Setter Property="Foreground" Value="#3A4A66" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="13,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="11" Background="#EEF1F7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#E1E6F0" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Danger -->
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="Foreground" Value="#D64545" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="13,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="11" Background="#FDE5E5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#FAD3D3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ════ 입력창 ════ -->
            <Style x:Key="Field" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="CaretBrush" Value="{StaticResource Signature}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="b" CornerRadius="12" Background="#FBFCFE"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1.4"
                                    Padding="12,9">
                                <Grid>
                                    <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" IsHitTestVisible="False"
                                               Foreground="{StaticResource Sub}" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <ScrollViewer x:Name="PART_ContentHost" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Signature}" />
                                    <Setter TargetName="b" Property="Background" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FieldPasswordBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="#FBFCFE" />
                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                <Setter Property="BorderThickness" Value="1.4" />
                <Setter Property="Padding" Value="12,9" />
            </Style>

            <!-- ════ ComboBox (둥근 테두리 커스텀) ════ -->
            <Style x:Key="ComboToggle" TargetType="ToggleButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="cb" CornerRadius="11" Background="#FBFCFE"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1.4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="26" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M0,0 L8,0 L4,5 Z" Fill="#7A879E" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cb" Property="BorderBrush" Value="{StaticResource Signature}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="Height" Value="38" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="tb" Style="{StaticResource ComboToggle}" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter x:Name="cp" Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="13,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Margin="13,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource Sub}"
                                           Visibility="Collapsed" />
                                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border CornerRadius="11" Background="White" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1.4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#2A3C66" BlurRadius="18" ShadowDepth="2" Opacity="0.12" />
                                        </Border.Effect>
                                        <ScrollViewer>
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Height" Value="38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="11,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ci" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="4,2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ci" Property="Background" Value="{StaticResource SignatureSoft}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 라벨 -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{StaticResource Sub}" />
                <Setter Property="Margin" Value="2,0,0,4" />
            </Style>

            <!-- 전역 기본 폰트 -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            </Style>

            <!-- ════ DatePicker (앱 톤 통일) ════ -->
            <Style TargetType="DatePickerTextBox">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePickerTextBox">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Border x:Name="b" CornerRadius="11" Background="#FBFCFE"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1.4" Padding="11,6">
                                <Grid x:Name="PART_Root">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" VerticalAlignment="Center" />
                                    <Button x:Name="PART_Button" Grid.Column="1" Width="24" Height="22" Margin="6,0,0,0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Path Width="15" Height="15" Stretch="Uniform" Stroke="{StaticResource Signature}"
                                              StrokeThickness="1.5" Fill="Transparent"
                                              Data="M2,4 H18 V18 H2 Z M2,8 H18 M6,2 V6 M14,2 V6" />
                                    </Button>
                                    <Popup x:Name="PART_Popup" StaysOpen="False" AllowsTransparency="True"
                                           Placement="Bottom" PlacementTarget="{Binding ElementName=b}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Signature}" />
                                    <Setter TargetName="b" Property="Background" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
