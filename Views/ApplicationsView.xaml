<UserControl x:Class="JobMore.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Grid Grid.Row="0" Margin="2,0,2,18">
            <TextBlock Text="지원현황" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}" />
        </Grid>

        <!-- 대시보드 (진행 중심) -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="3" Padding="18,15">
                <StackPanel>
                    <TextBlock Text="이번 주 마감" Foreground="{StaticResource Sub}" FontSize="12" />
                    <TextBlock Text="{Binding ThisWeekDeadlineCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Signature}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="3" Padding="18,15">
                <StackPanel>
                    <TextBlock Text="마감 임박 (3일내)" Foreground="{StaticResource Sub}" FontSize="12" />
                    <TextBlock Text="{Binding ImminentCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Coral}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="3" Padding="18,15">
                <StackPanel>
                    <TextBlock Text="면접 진행" Foreground="{StaticResource Sub}" FontSize="12" />
                    <TextBlock Text="{Binding InterviewingCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="3" Padding="18,15">
                <StackPanel>
                    <TextBlock Text="서류 합격률" Foreground="{StaticResource Sub}" FontSize="12" />
                    <TextBlock Text="{Binding DocumentPassRate}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- D-day 색 범례 + 액션 버튼 -->
        <Grid Grid.Row="2" Margin="6,0,2,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="D-day 색:" FontSize="11.5" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Border Width="10" Height="10" CornerRadius="5" Background="#D64545" VerticalAlignment="Center" />
                <TextBlock Text="마감 3일 이내" FontSize="11.5" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="5,0,14,0" />
                <Border Width="10" Height="10" CornerRadius="5" Background="#7C5CFC" VerticalAlignment="Center" />
                <TextBlock Text="그 외 예정" FontSize="11.5" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="5,0,14,0" />
                <Border Width="10" Height="10" CornerRadius="5" Background="#9EA3B8" VerticalAlignment="Center" />
                <TextBlock Text="지난 일정" FontSize="11.5" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="5,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="+ 지원 추가" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddCommand}" Margin="0,0,8,0" />
                <Button Content="저장" Style="{StaticResource GhostButton}" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>

        <!-- 본문 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- 목록 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="3" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource Field}" Margin="0,0,8,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="회사 · 직무 검색" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding StageFilterOptions}"
                                  SelectedItem="{Binding StageFilter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Converter={StaticResource EnumDesc}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="전체 단계">
                                                        <Setter Property="Text" Value="전체 단계" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ApplicationsView}"
                              SelectedItem="{Binding SelectedApplication}"
                              AutoGenerateColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" CanUserAddRows="False" IsReadOnly="True"
                              MinRowHeight="34" SelectionMode="Single" FontSize="13"
                              FontFamily="{StaticResource UiFont}"
                              CanUserSortColumns="True" CanUserResizeColumns="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SignatureSoft}" />
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="회사" Width="*" SortMemberPath="Company">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Company}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Ink}" Margin="0,4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="직무" Width="*" SortMemberPath="Position">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Position}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Ink}" Margin="0,4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="단계" Width="100" SortMemberPath="Stage">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{Binding Stage, Converter={StaticResource StageBrush}}">
                                            <TextBlock Text="{Binding Stage, Converter={StaticResource EnumDesc}}"
                                                       Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="D-day" Width="160" SortMemberPath="Dday">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="6" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{Binding Dday, Converter={StaticResource DdayBrush}}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding Dday, Converter={StaticResource DdayText}}"
                                                           Foreground="White" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding DdayLabel}" FontSize="10.5"
                                                       Foreground="{StaticResource Sub}" VerticalAlignment="Center"
                                                       Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="바로가기" Width="64" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🔗" ToolTip="공고 사이트 열기"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                FontSize="15" Padding="6" HorizontalAlignment="Center"
                                                Command="{Binding DataContext.OpenRowUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 상세 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3" Padding="20">
                <Grid>
                    <TextBlock Text="좌측에서 지원 건을 선택하세요"
                               Foreground="{StaticResource Sub}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedApplication}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Hidden" DataContext="{Binding SelectedApplication}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="상세 / 편집" FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                <Button Content="삭제" Style="{StaticResource DangerButton}" HorizontalAlignment="Right"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Grid>

                            <!-- 회사 색 (캘린더에 반영) -->
                            <TextBlock Text="회사 색 (캘린더 표시)" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding DataContext.ColorPalette, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Margin="0,0,0,14">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="28" Height="28" Margin="0,0,8,0" Cursor="Hand"
                                                Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Border CornerRadius="14" Background="{Binding Converter={StaticResource HexBrush}}" />
                                                        <TextBlock Text="✓" Foreground="White" FontSize="14" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Visibility>
                                                                <MultiBinding Converter="{StaticResource ColorMatch}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.SelectedApplication.ColorHex"
                                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </TextBlock.Visibility>
                                                        </TextBlock>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="회사" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Field}" Margin="0,0,0,12" />

                            <TextBlock Text="직무" Style="{StaticResource FieldLabel}" />

                            <!-- 직무 검색 (위) -->
                            <TextBox Style="{StaticResource Field}" FontSize="12" Tag="직무 검색" Margin="0,0,0,5"
                                     Text="{Binding DataContext.JobSearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                            <!-- 직접 입력 (바로 아래, 같은 그룹) -->
                            <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Tag="직접 입력"
                                     Style="{StaticResource Field}" FontSize="12" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding DataContext.JobResults, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          MaxHeight="110" Margin="0,0,0,12">
                                <ItemsControl.Template>
                                    <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Background="#FBFBFD" Padding="9,6" Margin="0,0,0,4"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Ink}" />
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource Sub}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="선택" Style="{StaticResource SubtleButton}" Padding="9,4" FontSize="11"
                                                        Command="{Binding DataContext.SelectJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="고용형태" Style="{StaticResource FieldLabel}" />
                                    <ComboBox SelectedItem="{Binding EmploymentType}"
                                              ItemsSource="{Binding DataContext.EmploymentTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDesc}}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="지원 경로" Style="{StaticResource FieldLabel}" />
                                    <ComboBox SelectedItem="{Binding Channel}"
                                              ItemsSource="{Binding DataContext.ChannelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDesc}}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="공고 URL" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding JobUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Field}" Margin="0,0,6,0" />
                                <Button Grid.Column="1" Content="🔗 열기" Style="{StaticResource SubtleButton}"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Grid>

                            <TextBlock Text="근무지" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Field}" Margin="0,0,0,12" />

                            <TextBlock Text="희망/제시 연봉" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ExpectedSalary, UpdateSourceTrigger=LostFocus}" Tag="숫자만 입력 (예: 5500 → 5,500만)"
                                     Style="{StaticResource Field}" Margin="0,0,0,12" />

                            <TextBlock Text="서류 마감일" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding Deadline}" Margin="0,0,0,12" />

                            <TextBlock Text="다음 일정일 (면접 등)" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding NextEventDate}" Margin="0,0,0,6" />
                            <ComboBox SelectedItem="{Binding NextEventLabel, Mode=TwoWay}" Margin="0,0,0,12"
                                      ItemsSource="{Binding DataContext.EventTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectionChanged="EventTypeCombo_SelectionChanged" />

                            <TextBlock Text="담당자/연락처" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Field}" Margin="0,0,0,12" />

                            <TextBlock Text="메모" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Field}" Margin="0,0,0,14" TextWrapping="Wrap"
                                     AcceptsReturn="True" MinHeight="64" VerticalScrollBarVisibility="Auto" />

                            <!-- 진행 단계 (이력 통합 · 클릭 이동 · 날짜 선택) -->
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,14" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="진행 단계  (이동은 아래 버튼 · 단계 클릭은 날짜 입력)" />

                            <Border CornerRadius="10" Background="{StaticResource Bg}" Padding="13,12" Margin="0,2,0,12">
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding DataContext.Steps, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Loaded="Step_Loaded">
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                        <!-- 날짜 (위) -->
                                                        <Grid MinHeight="26" Margin="0,0,0,5">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="10.5"
                                                                       Foreground="{StaticResource Sub}"
                                                                       Text="{Binding PassedDate, StringFormat='{}{0:MM.dd}', TargetNullValue='—'}"
                                                                       Visibility="{Binding IsDateEditing, Converter={StaticResource InverseBoolVis}}" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                                        Visibility="{Binding IsDateEditing, Converter={StaticResource BoolVis}}">
                                                                <DatePicker Width="124" SelectedDate="{Binding PassedDate, Mode=TwoWay}" />
                                                                <Button Content="✕" Width="26" Height="26" Margin="4,0,0,0" Cursor="Hand"
                                                                        Background="Transparent" BorderThickness="0" FontSize="12"
                                                                        Foreground="{StaticResource Sub}" ToolTip="날짜 지우기"
                                                                        CommandParameter="{Binding}"
                                                                        Command="{Binding DataContext.ClearStepDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <!-- 단계 pill (클릭=이동) -->
                                                        <Button Cursor="Hand" CommandParameter="{Binding}" Click="Step_Click"
                                                                Command="{Binding DataContext.SelectStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="pill" CornerRadius="13" Padding="13,6" Background="Transparent"
                                                                            BorderBrush="{StaticResource Line}" BorderThickness="1.4">
                                                                        <TextBlock x:Name="t" Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource Sub}" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                            <Setter TargetName="pill" Property="Background" Value="{StaticResource SignatureSoft}" />
                                                                            <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource SignatureSoft}" />
                                                                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource SignatureDeep}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter TargetName="pill" Property="Background" Value="{StaticResource Signature}" />
                                                                            <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource Signature}" />
                                                                            <Setter TargetName="t" Property="Foreground" Value="White" />
                                                                            <Setter TargetName="t" Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource Signature}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock Text="›" FontSize="15" Foreground="{StaticResource Sub}" VerticalAlignment="Bottom" Margin="4,0,4,8"
                                                               Visibility="{Binding IsLast, Converter={StaticResource InverseBoolVis}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- 단계 이동 / 마지막 단계 결과 (한 줄) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding DataContext.IsInProgressStage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
                                <Button Content="← 이전 단계" Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                                        Command="{Binding DataContext.RetreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="다음 단계 →" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding DataContext.AdvanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding DataContext.IsAtLastStage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolVis}}" />
                                <Button Content="최종합격" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                                        Command="{Binding DataContext.OfferResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding DataContext.IsAtLastStage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}" />
                                <Button Content="불합격" Style="{StaticResource DangerButton}" Margin="0,0,6,0"
                                        Command="{Binding DataContext.RejectResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding DataContext.IsAtLastStage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}" />
                                <Button Content="중도포기" Style="{StaticResource SubtleButton}"
                                        Command="{Binding DataContext.WithdrawResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding DataContext.IsAtLastStage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                            <TextBlock Text="마지막 단계입니다. 최종 결과를 선택하면 기록으로 이동합니다."
                                       FontSize="11" Foreground="{StaticResource Sub}" Margin="2,2,0,0"
                                       Visibility="{Binding DataContext.IsAtLastStage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
