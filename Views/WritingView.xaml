<UserControl x:Class="JobMore.Views.WritingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 항목 한 줄 (체크=AI포함, 글자클릭=삽입, ✕=삭제) -->
        <DataTemplate x:Key="ItemTemplate">
            <Border CornerRadius="9" Background="#F5F6FA" Padding="8,6" Margin="0,0,0,5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" VerticalAlignment="Center"
                              Margin="0,0,8,0" ToolTip="체크 해제 시 AI 생성에서 제외됩니다" />
                    <Button Grid.Column="1" Click="InsertItem_Click" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                            ToolTip="클릭하면 자소서 내용에 삽입됩니다">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource Sub}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Content="✕" Style="{StaticResource SubtleButton}" Padding="7,4" FontSize="11"
                            Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,18">
            <TextBlock Text="작성" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- 자소서 목록 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="3" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="내 자소서" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource Ink}" Margin="2,0,0,10" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding CoverLetters}"
                             SelectedItem="{Binding SelectedLetter}" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" CornerRadius="10" Padding="12,10"
                                                    Background="#F6F7FB" BorderThickness="1.4" BorderBrush="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SignatureSoft}" />
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Signature}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource Sub}" Margin="0,3,0,0">
                                        <Run Text="{Binding CharCount, Mode=OneWay}" /><Run Text="자" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Content="+ 새 자소서" Style="{StaticResource GhostButton}"
                            Command="{Binding AddLetterCommand}" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- 자소서 편집 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3" Padding="20">
                <Grid>
                    <TextBlock Text="왼쪽에서 자소서를 선택하거나 새로 만드세요"
                               Foreground="{StaticResource Sub}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedLetter}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedLetter}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="제목" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Field}"
                                     Text="{Binding LetterTitle, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="문항" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Field}"
                                     Text="{Binding LetterQuestion, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,0,0,6">
                            <TextBlock Text="내용" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding LetterCharInfo}" FontSize="11"
                                       Foreground="{StaticResource Sub}" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBox Grid.Row="3" x:Name="ContentBox" Style="{StaticResource Field}"
                                 Text="{Binding LetterContent, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" />

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{Binding GenerateLabel}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding GenerateCommand}" Margin="0,0,8,0" />
                            <Button Content="📋 복사" Style="{StaticResource CopyButton}"
                                    Command="{Binding CopyLetterCommand}" Margin="0,0,8,0" />
                            <Button Content="저장" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveLetterCommand}" Margin="0,0,8,0" />
                            <Button Content="삭제" Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteLetterCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 내 항목 (자격증/학력/대외활동) -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="3" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="내 항목" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Ink}" Margin="2,0,0,4" />
                        <TextBlock Text="글자 클릭=삽입 · 체크=AI 포함" FontSize="11" Foreground="{StaticResource Sub}" Margin="2,0,0,12" />

                        <!-- 희망 직무 -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="희망 직무" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            <ToggleButton IsChecked="{Binding IsJobOpen}" HorizontalAlignment="Right" Width="28" Height="22"
                                          Background="Transparent" BorderThickness="0" Cursor="Hand" Content="▾" FontSize="12"
                                          Foreground="{StaticResource Sub}" />
                        </Grid>
                        <StackPanel Visibility="{Binding IsJobOpen, Converter={StaticResource BoolVis}}" Margin="0,0,0,12">
                            <TextBox Style="{StaticResource Field}" Margin="0,0,0,8" FontSize="12"
                                     Text="{Binding JobSearchText, UpdateSourceTrigger=PropertyChanged}" Tag="직무 검색" />
                            <ItemsControl ItemsSource="{Binding JobResults}" MaxHeight="120">
                                <ItemsControl.Template>
                                    <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Background="#FBFBFD" Padding="9,6" Margin="0,0,0,4"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource Sub}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="+ 담기" Style="{StaticResource SubtleButton}" Padding="9,4" FontSize="11"
                                                        Command="{Binding DataContext.AddJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource Field}" FontSize="12" Margin="0,0,6,0"
                                         Text="{Binding JobManual, UpdateSourceTrigger=PropertyChanged}" Tag="직접 입력" />
                                <Button Grid.Column="1" Content="+ 추가" Style="{StaticResource GhostButton}" Padding="12,7" FontSize="11"
                                        Command="{Binding AddJobManualCommand}" />
                            </Grid>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding DesiredJobItems}" ItemTemplate="{StaticResource ItemTemplate}" Margin="0,0,0,12" />

                        <!-- 경력 -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="경력" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            <ToggleButton IsChecked="{Binding IsCareerOpen}" HorizontalAlignment="Right" Width="28" Height="22"
                                          Background="Transparent" BorderThickness="0" Cursor="Hand" Content="▾" FontSize="12"
                                          Foreground="{StaticResource Sub}" />
                        </Grid>
                        <StackPanel Visibility="{Binding IsCareerOpen, Converter={StaticResource BoolVis}}" Margin="0,0,0,12">
                            <TextBox Style="{StaticResource Field}" Margin="0,0,0,5" FontSize="12"
                                     Text="{Binding CareerCompany, UpdateSourceTrigger=PropertyChanged}" Tag="회사" />
                            <TextBox Style="{StaticResource Field}" Margin="0,0,0,5" FontSize="12"
                                     Text="{Binding CareerRole, UpdateSourceTrigger=PropertyChanged}" Tag="직무" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" SelectedDate="{Binding CareerStart, Mode=TwoWay}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="~" VerticalAlignment="Center" Margin="6,0"
                                               Foreground="{StaticResource Sub}" />
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding CareerEnd, Mode=TwoWay}" FontSize="11" />
                                </Grid>
                                <Button Grid.Column="1" Content="+ 추가" Style="{StaticResource GhostButton}" Padding="12,7" FontSize="11"
                                        Command="{Binding AddCareerCommand}" />
                            </Grid>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding CareerItems}" ItemTemplate="{StaticResource ItemTemplate}" Margin="0,0,0,12" />

                        <!-- 자격증 -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="자격증" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            <ToggleButton IsChecked="{Binding IsCertOpen}" HorizontalAlignment="Right" Width="28" Height="22"
                                          Background="Transparent" BorderThickness="0" Cursor="Hand" Content="▾" FontSize="12"
                                          Foreground="{StaticResource Sub}" />
                        </Grid>
                        <StackPanel Visibility="{Binding IsCertOpen, Converter={StaticResource BoolVis}}" Margin="0,0,0,12">
                            <TextBox Style="{StaticResource Field}" Margin="0,0,0,8" FontSize="12"
                                     Text="{Binding CertSearchText, UpdateSourceTrigger=PropertyChanged}" Tag="자격증 검색" />
                            <ItemsControl ItemsSource="{Binding CertResults}" MaxHeight="120">
                                <ItemsControl.Template>
                                    <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Background="#FBFBFD" Padding="9,6" Margin="0,0,0,4"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Content="+ 담기" Style="{StaticResource SubtleButton}" Padding="9,4" FontSize="11"
                                                        Command="{Binding DataContext.AddCertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding CertItems}" ItemTemplate="{StaticResource ItemTemplate}" Margin="0,0,0,12" />

                        <!-- 학력 -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="학력" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            <ToggleButton IsChecked="{Binding IsEduOpen}" HorizontalAlignment="Right" Width="28" Height="22"
                                          Background="Transparent" BorderThickness="0" Cursor="Hand" Content="▾" FontSize="12"
                                          Foreground="{StaticResource Sub}" />
                        </Grid>
                        <StackPanel Visibility="{Binding IsEduOpen, Converter={StaticResource BoolVis}}" Margin="0,0,0,12">
                            <TextBox Style="{StaticResource Field}" Margin="0,0,0,5" FontSize="12"
                                     Text="{Binding EduSchool, UpdateSourceTrigger=PropertyChanged}" Tag="학교" />
                            <TextBox Style="{StaticResource Field}" Margin="0,0,0,5" FontSize="12"
                                     Text="{Binding EduMajor, UpdateSourceTrigger=PropertyChanged}" Tag="전공" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" SelectedDate="{Binding EduStart, Mode=TwoWay}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="~" VerticalAlignment="Center" Margin="6,0"
                                               Foreground="{StaticResource Sub}" />
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding EduEnd, Mode=TwoWay}" FontSize="11" />
                                </Grid>
                                <Button Grid.Column="1" Content="+ 추가" Style="{StaticResource GhostButton}" Padding="12,7" FontSize="11"
                                        Command="{Binding AddEducationCommand}" />
                            </Grid>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding EduItems}" ItemTemplate="{StaticResource ItemTemplate}" Margin="0,0,0,12" />

                        <!-- 대외활동 -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="대외활동" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            <ToggleButton IsChecked="{Binding IsActOpen}" HorizontalAlignment="Right" Width="28" Height="22"
                                          Background="Transparent" BorderThickness="0" Cursor="Hand" Content="▾" FontSize="12"
                                          Foreground="{StaticResource Sub}" />
                        </Grid>
                        <StackPanel Visibility="{Binding IsActOpen, Converter={StaticResource BoolVis}}">
                            <TextBox Style="{StaticResource Field}" Margin="0,0,0,5" FontSize="12"
                                     Text="{Binding ActTitle, UpdateSourceTrigger=PropertyChanged}" Tag="활동명" />
                            <TextBox Style="{StaticResource Field}" Margin="0,0,0,5" FontSize="12"
                                     Text="{Binding ActOrg, UpdateSourceTrigger=PropertyChanged}" Tag="기관" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" SelectedDate="{Binding ActStart, Mode=TwoWay}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="~" VerticalAlignment="Center" Margin="6,0"
                                               Foreground="{StaticResource Sub}" />
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding ActEnd, Mode=TwoWay}" FontSize="11" />
                                </Grid>
                                <Button Grid.Column="1" Content="+ 추가" Style="{StaticResource GhostButton}" Padding="12,7" FontSize="11"
                                        Command="{Binding AddActivityCommand}" />
                            </Grid>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ActItems}" ItemTemplate="{StaticResource ItemTemplate}" Margin="0,0,0,12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
