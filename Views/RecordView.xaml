<UserControl x:Class="JobMore.Views.RecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,14">
            <TextBlock Text="기록" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}" />
        </StackPanel>

        <!-- 서브탭 -->
        <Border Grid.Row="1" Background="#EEF0F6" CornerRadius="11" Padding="4" HorizontalAlignment="Left" Margin="2,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="목록" Command="{Binding ShowListCommand}" Cursor="Hand" Padding="18,8"
                        FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="t" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding ShowList}" Value="True">
                                    <Setter TargetName="t" Property="Background" Value="White" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="통계·차트" Command="{Binding ShowStatsCommand}" Cursor="Hand" Padding="18,8"
                        FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="t" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding ShowStats}" Value="True">
                                    <Setter TargetName="t" Property="Background" Value="White" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- 목록 영역 -->
        <Grid Grid.Row="2" Visibility="{Binding ShowList, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 전체 지원 이력 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="3" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="전체 지원 이력" FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding StageFilterOptions}"
                                  SelectedItem="{Binding StageFilter}" VerticalAlignment="Center" Height="34">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Converter={StaticResource EnumDesc}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="전체">
                                                        <Setter Property="Text" Value="전체" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" Content="↩ 진행중으로 되돌리기" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" Command="{Binding RestoreCommand}"
                                ToolTip="최종합격·불합격·중도포기 건을 선택하면 다시 진행중으로 되돌릴 수 있어요" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryView}"
                              SelectedItem="{Binding SelectedRecord}"
                              AutoGenerateColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" CanUserAddRows="False" IsReadOnly="True"
                              SelectionMode="Single" MinRowHeight="34" FontSize="13" FontFamily="{StaticResource UiFont}"
                              CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SignatureSoft}" />
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="지원일" Binding="{Binding AppliedDate}" Width="110" />
                            <DataGridTemplateColumn Header="회사" Width="*" SortMemberPath="Company">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Company}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Ink}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="직무" Width="*" SortMemberPath="Position">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Position}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Ink}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="단계/결과" Binding="{Binding Stage}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 상세 보기 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3" Padding="22">
                <Grid>
                    <!-- 미선택 안내 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRecord}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="📄" FontSize="30" HorizontalAlignment="Center" Opacity="0.5" />
                        <TextBlock Text="이력을 클릭하면 상세가 표시됩니다" Foreground="{StaticResource Sub}"
                                   FontSize="13" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- 상세 -->
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" DataContext="{Binding SelectedRecord}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <TextBlock Text="{Binding Company}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Position}" FontSize="13"
                                       Foreground="{StaticResource Sub}" Margin="0,2,0,10" />

                            <Border CornerRadius="9" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,16"
                                    Background="{Binding App.Stage, Converter={StaticResource StageBrush}}">
                                <TextBlock Text="{Binding App.Stage, Converter={StaticResource EnumDesc}}"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="지원 경로" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding App.Channel, Converter={StaticResource EnumDesc}}"
                                               FontSize="13" Foreground="{StaticResource Ink}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="고용형태" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding App.EmploymentType, Converter={StaticResource EnumDesc}}"
                                               FontSize="13" Foreground="{StaticResource Ink}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="지원일" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding AppliedDate}" FontSize="13"
                                       Foreground="{StaticResource Ink}" Margin="0,0,0,12" />

                            <TextBlock Text="서류 마감일" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding App.Deadline, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue='-'}"
                                       FontSize="13" Foreground="{StaticResource Ink}" Margin="0,0,0,12" />

                            <TextBlock Text="근무지" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding App.Location, TargetNullValue='-'}" FontSize="13"
                                       Foreground="{StaticResource Ink}" Margin="0,0,0,12" TextWrapping="Wrap" />

                            <TextBlock Text="희망/제시 연봉" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding App.ExpectedSalary, TargetNullValue='-'}" FontSize="13"
                                       Foreground="{StaticResource Ink}" Margin="0,0,0,12" />

                            <TextBlock Text="공고 URL" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding App.JobUrl, TargetNullValue='-'}"
                                           FontSize="12.5" Foreground="{StaticResource Signature}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="🔗 열기" Style="{StaticResource SubtleButton}"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Grid>

                            <TextBlock Text="메모" Style="{StaticResource FieldLabel}" />
                            <Border Background="#F5F6FA" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                <TextBlock Text="{Binding App.Memo, TargetNullValue='-'}" FontSize="13"
                                           Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="진행 이력" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource Ink}" Margin="0,4,0,8" />
                            <ItemsControl ItemsSource="{Binding App.StageLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="8" Padding="8,3"
                                                    Background="{Binding Stage, Converter={StaticResource StageBrush}}">
                                                <TextBlock Text="{Binding Stage, Converter={StaticResource EnumDesc}}"
                                                           Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding ChangedAt, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                       Foreground="{StaticResource Sub}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,14" />
                            <Button Content="이 기록 삭제" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <!-- 통계·차트 영역 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden"
                      Visibility="{Binding ShowStats, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <UniformGrid Columns="5" Margin="0,0,0,8">
                    <Border Style="{StaticResource Card}" Margin="3" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="전체 지원" Foreground="{StaticResource Sub}" FontSize="12" />
                            <TextBlock Text="{Binding TotalCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="3" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="최종합격" Foreground="{StaticResource Sub}" FontSize="12" />
                            <TextBlock Text="{Binding OfferCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Mint}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="3" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="불합격" Foreground="{StaticResource Sub}" FontSize="12" />
                            <TextBlock Text="{Binding RejectedCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Coral}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="3" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="중도포기" Foreground="{StaticResource Sub}" FontSize="12" />
                            <TextBlock Text="{Binding WithdrawnCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Sub}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="3" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="최종 합격률" Foreground="{StaticResource Sub}" FontSize="12" />
                            <TextBlock Text="{Binding OfferRate}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Signature}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 단계별 합격 그래프 -->
                <Border Style="{StaticResource Card}" Margin="3" Padding="22">
                    <StackPanel>
                        <TextBlock Text="단계별 합격 현황" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Ink}" Margin="0,0,0,4" />
                        <TextBlock Text="지원이 단계별로 얼마나 통과했는지 (괄호 = 지원 대비 비율)" FontSize="11.5"
                                   Foreground="{StaticResource Sub}" Margin="0,0,0,16" />
                        <ItemsControl ItemsSource="{Binding Funnel}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" Height="28" VerticalAlignment="Center">
                                            <Border CornerRadius="7" Background="#F0F2F7" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding FillStars, Converter={StaticResource StarLen}}" />
                                                    <ColumnDefinition Width="{Binding RestStars, Converter={StaticResource StarLen}}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="7"
                                                        Background="{Binding ColorHex, Converter={StaticResource HexBrush}}" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   FontSize="13" Foreground="{StaticResource Ink}">
                                            <Run Text="{Binding Count, Mode=OneWay}" FontWeight="Bold" /><Run Text=" 건 (" /><Run Text="{Binding Percent, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 도넛 2개 (가로 반반) -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 직무별 지원 -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="3" Padding="20">
                        <StackPanel>
                            <TextBlock Text="직무별 지원" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Ink}" Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="150" Height="150" VerticalAlignment="Top">
                                    <Viewbox>
                                        <ItemsControl ItemsSource="{Binding JobDonut}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas Width="200" Height="200" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding Geometry}" Fill="{Binding Fill}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Viewbox>
                                    <TextBlock Text="{Binding JobDonutEmpty}" Foreground="{StaticResource Sub}" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding JobDonut}" Margin="14,2,0,0" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="11" Height="11" CornerRadius="3"
                                                        Background="{Binding Fill}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Ink}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Sub}">
                                                    <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="건 · " /><Run Text="{Binding Percent, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 고용형태별 지원 -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3" Padding="20">
                        <StackPanel>
                            <TextBlock Text="고용형태별 지원" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Ink}" Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="150" Height="150" VerticalAlignment="Top">
                                    <Viewbox>
                                        <ItemsControl ItemsSource="{Binding EmpDonut}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas Width="200" Height="200" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding Geometry}" Fill="{Binding Fill}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Viewbox>
                                    <TextBlock Text="{Binding EmpDonutEmpty}" Foreground="{StaticResource Sub}" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding EmpDonut}" Margin="14,2,0,0" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="11" Height="11" CornerRadius="3"
                                                        Background="{Binding Fill}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Ink}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Sub}">
                                                    <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="건 · " /><Run Text="{Binding Percent, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
