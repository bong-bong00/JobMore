<UserControl x:Class="JobMore.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,18">
            <TextBlock Text="일정" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 달력 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="3" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 월 이동 헤더 -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="◀" Style="{StaticResource SubtleButton}" Padding="11,6"
                                    Command="{Binding PrevMonthCommand}" />
                            <TextBlock Text="{Binding MonthLabel}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="14,0" />
                            <Button Content="▶" Style="{StaticResource SubtleButton}" Padding="11,6"
                                    Command="{Binding NextMonthCommand}" />
                            <Button Content="오늘" Style="{StaticResource GhostButton}" Padding="13,6" Margin="10,0,0,0"
                                    Command="{Binding TodayCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Width="9" Height="9" CornerRadius="5" Background="#D64545" VerticalAlignment="Center" />
                            <TextBlock Text="마감" FontSize="11.5" Foreground="{StaticResource Sub}" Margin="5,0,14,0" VerticalAlignment="Center" />
                            <Border Width="9" Height="9" CornerRadius="5" Background="{StaticResource Signature}" VerticalAlignment="Center" />
                            <TextBlock Text="면접/일정" FontSize="11.5" Foreground="{StaticResource Sub}" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- 요일 헤더 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekHeaders}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource Sub}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 날짜 그리드 -->
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Cursor="Hand" Margin="2"
                                        Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="cell" CornerRadius="10" Background="Transparent"
                                                    BorderBrush="Transparent" BorderThickness="1.5" MinHeight="78" Padding="6,5">
                                                <StackPanel>
                                                    <TextBlock x:Name="num" Text="{Binding Day}" FontSize="12.5"
                                                               Foreground="{StaticResource Ink}" Margin="2,0,0,3" />
                                                    <ItemsControl ItemsSource="{Binding Events}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="4" Margin="0,0,0,2" Padding="4,2"
                                                                        Background="{Binding BarColor, Converter={StaticResource HexBrush}}">
                                                                    <TextBlock Text="{Binding Company}" Foreground="White" FontSize="9.5"
                                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding InMonth}" Value="False">
                                                    <Setter TargetName="num" Property="Foreground" Value="#C2C8D4" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="cell" Property="Background" Value="{StaticResource SignatureSoft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="cell" Property="BorderBrush" Value="{StaticResource Signature}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="cell" Property="Background" Value="#F1F3F8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 선택한 날 일정 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding SelectedDayLabel}" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource Ink}" Margin="2,0,0,4" />
                    <TextBlock Grid.Row="1" Margin="2,0,0,12" FontSize="12" Foreground="{StaticResource Sub}">
                        <Run Text="이번 달 마감 " /><Run Text="{Binding MonthDeadlineCount, Mode=OneWay}" /><Run Text="건 · 면접 " /><Run Text="{Binding MonthInterviewCount, Mode=OneWay}" /><Run Text="건" />
                    </TextBlock>

                    <Grid Grid.Row="2">
                        <TextBlock Text="이 날은 일정이 없어요" Foreground="{StaticResource Sub}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedEvents}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding SelectedEvents}">
                            <ItemsControl.Template>
                                <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="#F5F6FA" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border CornerRadius="6" Padding="7,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource Signature}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="마감">
                                                                    <Setter Property="Background" Value="#D64545" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Kind}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Company}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="7,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource Sub}" Margin="0,0,0,6" />

                                            <!-- 현재 날짜 + '날짜 변경' 버튼 (기본 상태) -->
                                            <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolVis}}">
                                                <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource Ink}"
                                                           Text="{Binding EditableDate, StringFormat='{}{0:yyyy.MM.dd}'}" />
                                                <ToggleButton Content="날짜 변경" IsChecked="{Binding IsEditing, Mode=TwoWay}"
                                                              HorizontalAlignment="Right" Cursor="Hand" Padding="11,5" FontSize="11"
                                                              FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Signature}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border CornerRadius="9" Background="{StaticResource SignatureSoft}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                            </Grid>

                                            <!-- 날짜 선택 UI (버튼 눌렀을 때) -->
                                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="날짜 선택" FontSize="10.5" Foreground="{StaticResource Sub}" Margin="1,0,0,3" />
                                                <DatePicker SelectedDate="{Binding EditableDate, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
