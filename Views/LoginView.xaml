<UserControl x:Class="JobMore.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White">
        <Border CornerRadius="20" Background="White" Width="420"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#2A3C66" BlurRadius="32" ShadowDepth="3" Opacity="0.12" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 컬러 헤더 -->
                <Border Grid.Row="0" Background="{StaticResource SignatureGrad}"
                        CornerRadius="20,20,0,0" Padding="36,30,36,28">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="92" Height="92" Stretch="Uniform" Margin="0,0,0,10" />
                        <TextBlock Text="잡모아" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="흩어진 지원 현황을 모아서, 합격은 더(More)"
                                   FontSize="12.5" Foreground="#EFEAFE" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 입력 -->
                <StackPanel Grid.Row="1" Margin="36,28,36,32">
                    <TextBlock Text="아이디" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Field}" Margin="0,0,0,14" />

                    <TextBlock Text="비밀번호" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldPasswordBorder}" Margin="0,0,0,22">
                        <PasswordBox x:Name="PwBox" BorderThickness="0" Background="Transparent"
                                     FontSize="13" PasswordChanged="PwBox_PasswordChanged" />
                    </Border>

                    <Button Content="로그인" Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoginCommand}" Height="46" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <TextBlock Text="아직 계정이 없으신가요?" FontSize="12.5"
                                   Foreground="{StaticResource Sub}" VerticalAlignment="Center" />
                        <Button Content="회원가입" Command="{Binding SignUpCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{StaticResource Signature}" FontWeight="SemiBold"
                                FontSize="12.5" Margin="6,0,0,0" Padding="0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
