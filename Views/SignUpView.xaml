<UserControl x:Class="JobMore.Views.SignUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White">
        <Border CornerRadius="20" Background="White" Width="460" MaxHeight="740"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#2A3C66" BlurRadius="32" ShadowDepth="3" Opacity="0.12" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 컬러 헤더 -->
                <Border Grid.Row="0" Background="{StaticResource SignatureGrad}"
                        CornerRadius="20,20,0,0" Padding="34,26,34,24">
                    <StackPanel>
                        <TextBlock Text="회원가입" FontSize="24" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="잡모아 계정을 만들어 시작하세요"
                                   FontSize="12" Foreground="#EFEAFE" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="34,22,34,28">
                    <StackPanel>
                        <TextBlock Text="이름 *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Field}" Margin="0,0,0,14" />

                        <TextBlock Text="나이" Style="{StaticResource FieldLabel}" />
                        <ComboBox SelectedItem="{Binding Age}" ItemsSource="{Binding AgeOptions}"
                                  Margin="0,0,0,14" MaxDropDownHeight="220" />

                        <TextBlock Text="아이디 *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Field}" Margin="0,0,0,14" />

                        <TextBlock Text="비밀번호 *" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldPasswordBorder}" Margin="0,0,0,14">
                            <PasswordBox x:Name="PwBox" BorderThickness="0" Background="Transparent"
                                         FontSize="13" PasswordChanged="PwBox_PasswordChanged" />
                        </Border>


                        <Button Content="시작하기" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SignUpCommand}" Height="46" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock Text="이미 계정이 있으신가요?" FontSize="12.5"
                                       Foreground="{StaticResource Sub}" VerticalAlignment="Center" />
                            <Button Content="로그인" Command="{Binding GoLoginCommand}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="{StaticResource Signature}" FontWeight="SemiBold"
                                    FontSize="12.5" Margin="6,0,0,0" Padding="0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
